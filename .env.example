# Agent Core
PORT=4000
NODE_ENV=development
# Comma-separated PWA origins allowed to call the Core. Set the deployed
# origin here once the Core is live (for example, https://pulse.handeia.com).
CORS_ORIGIN=http://localhost:5173

# AI reasoning (optional — the Context Engine and Reasoning steps fall back
# to a deterministic heuristic when this is unset, see README)
OPENAI_API_KEY=

# Persistence — Supabase project your teammate created for PULSE (see
# "Pulse Gaia — Plan de Base de Datos" in Obsidian for the schema). Falls
# back to in-memory storage (lost on restart) when unset — fine for local
# dev, not for the real demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Handeia handoff (see "Pulse Gaia — Plan Gandia 7 Developers (Handeia)").
# This is the key_secret from the `developer_api_keys` row Gandia-7 created
# for PULSE's capability — the same secret Gandia-7 used to SIGN the
# handeia_token is what PULSE needs to VERIFY it (routes/auth.ts).
HANDEIA_CAPABILITY_KEY_SECRET=

# Agent Surface (web) — only used by `pnpm dev` (Vite dev server on :5173).
# In production the Core serves the surface's static build itself (see
# server.ts) and these are baked in at build time instead.
VITE_CORE_WS_URL=ws://localhost:4000/ws
VITE_CORE_HTTP_URL=http://localhost:4000
