# Agent Core
PORT=4000
NODE_ENV=development
# Comma-separated PWA origins allowed to call the Core. Set the deployed
# Vercel URL here (for example, https://pulse-gaia.vercel.app).
CORS_ORIGIN=http://localhost:5173

# AI reasoning
OPENAI_API_KEY=

# Persistence (local Postgres via docker-compose, or a Supabase project)
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared agent/user identity across devices (placeholder until real auth is wired)
AGENT_IDENTITY_SECRET=change-me

# Agent Surface (web)
VITE_CORE_WS_URL=ws://localhost:4000/ws
VITE_CORE_HTTP_URL=http://localhost:4000
